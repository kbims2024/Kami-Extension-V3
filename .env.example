# ==============================================
# KAMI-EXTENSION - Variables d'environnement
# ==============================================
#
# Copiez ce fichier en .env.local et remplissez les valeurs.
# Sur Vercel, configurez ces variables dans Settings > Environment Variables.
#

# --- Base de données MongoDB (OBLIGATOIRE) ---
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/kami?retryWrites=true&w=majority

# --- NextAuth (optionnel, pour authentification avancée) ---
# NEXTAUTH_URL=https://votre-domaine.vercel.app
# NEXTAUTH_SECRET=votre-secret-ici
