// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(cuid())
  name                String
  phone               String      @unique
  email               String?     @unique
  password            String?
  role                String      @default("USER") // USER, ADMIN, MANAGEMENT_COMMITTEE
  isResident          Boolean     @default(true)
  referralCode        String?     @unique
  referredByCode      String?
  referrer            User?       @relation("Referrals", fields: [referredByCode], references: [referralCode])
  referrals           User[]      @relation("Referrals")
  status              String      @default("ACTIVE") // ACTIVE, BLOCKED
  resetToken          String?     @unique
  resetTokenExpires   DateTime?
  quartier            String?
  pseudo              String?
  congratulatedLots   String      @default("") // JSON array of lot IDs the user has been congratulated for
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  reservations        Reservation[]
  payments            Payment[]
  sentMessages        Message[]   @relation("SentMessages")
  receivedMessages    Message[]   @relation("ReceivedMessages")
}

model Lot {
  id          String      @id @default(cuid())
  name        String
  block       String      // Îlot (ex: A, B, C)
  surface     String
  priceRes    Int
  priceNon    Int
  status      String      @default("AVAILABLE") // AVAILABLE, RESERVED, PAID
  description String?
  positionX   Float?      // Position X sur la carte
  positionY   Float?      // Position Y sur la carte
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reservations Reservation[]
  payments    Payment[]
}

model Reservation {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  lotId         String
  lot           Lot         @relation(fields: [lotId], references: [id])
  paidAmount    Int         @default(0)
  totalPrice    Int
  isResident    Boolean
  status        String      @default("RESERVED") // RESERVED, PAID
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Payment {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  lotId       String
  lot         Lot         @relation(fields: [lotId], references: [id])
  amount      Int
  status      String      @default("PENDING") // PENDING, VALIDATED
  type        String      // FULL, PARTIAL
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AdminFile {
  id          String      @id @default(cuid())
  type        String      @unique // PLAN, DOCUMENT, etc.
  filename    String
  path        String
  mimeType    String
  size        Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Logo {
  id              String      @id @default(cuid())
  text            String      @default("KAMI-EXTENSION")
  imageUrl        String?
  textColor       String      @default("#8B5E3C")
  backgroundColor String      @default("#ffffff")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Message {
  id          String      @id @default(cuid())
  senderId    String
  sender      User        @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content     String
  read        Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([senderId])
  @@index([receiverId])
}

model Settings {
  id              String      @id @default(cuid())
  heroBackground  String?     // Background image for hero section
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
