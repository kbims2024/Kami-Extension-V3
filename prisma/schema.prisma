// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  name            String
  phone           String      @unique
  isResident      Boolean     @default(true)
  referralCode    String?     @unique
  referredByCode  String?
  referrer        User?       @relation("Referrals", fields: [referredByCode], references: [referralCode])
  referrals       User[]      @relation("Referrals")
  status          String      @default("ACTIVE") // ACTIVE, BLOCKED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  reservations    Reservation[]
  payments        Payment[]
}

model Lot {
  id          String      @id @default(cuid())
  name        String
  block       String      // Îlot / Bloc (ex: A, B, C)
  surface     String
  priceRes    Int
  priceNon    Int
  status      String      @default("AVAILABLE") // AVAILABLE, RESERVED, PAID
  description String?
  positionX   Float?      // Position X sur la carte
  positionY   Float?      // Position Y sur la carte
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reservations Reservation[]
  payments    Payment[]
}

model Reservation {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  lotId         String
  lot           Lot         @relation(fields: [lotId], references: [id])
  paidAmount    Int         @default(0)
  totalPrice    Int
  isResident    Boolean
  status        String      @default("RESERVED") // RESERVED, PAID
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Payment {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  lotId       String
  lot         Lot         @relation(fields: [lotId], references: [id])
  amount      Int
  status      String      @default("PENDING") // PENDING, VALIDATED
  type        String      // FULL, PARTIAL
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
